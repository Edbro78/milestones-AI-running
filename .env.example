# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (kun server-side)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Garmin Connect (server-side only — never expose to the client)
# Eksisterende tilkobling via garmin-connect (e-post/passord + tokens i DB)
GARMIN_EMAIL=
GARMIN_PASSWORD=
# true = demodata (ikke live). La stå unset/false for ekte Garmin.
GARMIN_MOCK=false
