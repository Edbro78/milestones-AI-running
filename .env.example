# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (kun server-side)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Garmin Connect Health API (kun server-side — aldri eksponert mot klient)
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_REDIRECT_URI=
# true = bruk MockGarminProvider (realistisk 28d historikk, ingen Garmin-godkjenning)
GARMIN_MOCK=true

# Seed-skript
SEED_EMAIL=
